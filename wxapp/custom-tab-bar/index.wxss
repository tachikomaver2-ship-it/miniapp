.bar {
  position: fixed;
  bottom: 24rpx;
  left: 32rpx;
  right: 32rpx;
  height: 128rpx;
  background: #FFFDF7;
  border: 4rpx solid #1C1726;
  border-radius: 99rpx;
  box-shadow: 8rpx 8rpx 0 #1C1726;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 99;
}
.item { display: flex; flex-direction: column; align-items: center; width: 120rpx; }
.ic { font-size: 40rpx; line-height: 48rpx; }
.lb { font-size: 20rpx; font-weight: 800; margin-top: 2rpx; color: #8a84a0; }
.item.on .lb { color: #6C4DFF; }
.item.on .ic { transform: scale(1.12); }

/* 中央 AI 大按钮 */
.blob {
  margin-top: -72rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #6C4DFF;
  color: #fff;
  border: 4rpx solid #1C1726;
  box-shadow: 6rpx 6rpx 0 #1C1726;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
}
.blob-on { background: #FFC531; color: #1C1726; transform: rotate(-8deg); }
.item:active .blob { transform: scale(.92); }
