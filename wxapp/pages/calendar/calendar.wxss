.page { padding: 100rpx 32rpx 220rpx; }
.head { margin-bottom: 24rpx; }
.brand { font-size: 40rpx; font-weight: 900; }
.rail { display: flex; gap: 16rpx; white-space: nowrap; padding: 10rpx 0 20rpx; }
.day { flex-shrink: 0; width: 120rpx; border: 4rpx solid var(--ink); border-radius: 22rpx; background: var(--paper); display: flex; flex-direction: column; align-items: center; padding: 14rpx 0; gap: 4rpx; box-shadow: 4rpx 4rpx 0 var(--ink); }
.day.on { background: var(--lime); }
.day.has .d-cnt { color: var(--coral); }
.d-wd { font-size: 18rpx; font-weight: 800; color: var(--muted); }
.d-num { font-size: 34rpx; font-weight: 900; }
.d-cnt { font-size: 18rpx; font-weight: 900; color: var(--muted); }
.rows { display: flex; flex-direction: column; gap: 22rpx; }
.row-card { display: flex; align-items: center; gap: 20rpx; padding: 22rpx; }
.row-card:active { transform: translate(4rpx,4rpx); box-shadow: 4rpx 4rpx 0 var(--ink); }
.rc-grad { width: 110rpx; height: 110rpx; border: 4rpx solid var(--ink); border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 56rpx; flex-shrink: 0; }
.rc-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.rc-i-title { font-weight: 900; font-size: 28rpx; }
.rc-i-meta { font-size: 20rpx; color: var(--muted); font-weight: 700; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rc-i-price { font-weight: 900; font-size: 30rpx; }
.empty { text-align: center; color: var(--muted); font-weight: 800; padding: 80rpx 0; }
