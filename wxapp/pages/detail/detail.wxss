.page { padding-bottom: 60rpx; }
.cover { position: relative; height: 420rpx; border-bottom: 4rpx solid var(--ink); display: flex; align-items: center; justify-content: center; }
.c-emoji { font-size: 200rpx; opacity: .5; transform: rotate(-6deg); }
.c-back, .c-share { position: absolute; top: 100rpx; border: 4rpx solid var(--ink); border-radius: 99rpx; background: var(--paper); box-shadow: 4rpx 4rpx 0 var(--ink); font-weight: 900; font-size: 24rpx; padding: 8rpx 22rpx; }
.c-back { left: 32rpx; font-size: 36rpx; padding: 4rpx 24rpx; }
.c-share { right: 32rpx; }
.body { padding: 28rpx 32rpx; }
.tags { display: flex; gap: 14rpx; flex-wrap: wrap; }
.tag { font-size: 20rpx; font-weight: 900; border: 3rpx solid var(--ink); border-radius: 99rpx; padding: 5rpx 18rpx; }
.tag.paper { background: var(--paper); }
.tag.ink { background: var(--ink); color: var(--lime); }
.title { display: block; font-size: 40rpx; font-weight: 900; margin: 20rpx 0 8rpx; }
.info { display: flex; flex-direction: column; gap: 20rpx; margin: 24rpx 0; }
.li { display: flex; gap: 18rpx; align-items: center; }
.ic { font-size: 32rpx; width: 56rpx; height: 56rpx; background: var(--cream); border: 3rpx solid var(--ink); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.li-t { display: flex; flex-direction: column; }
.li-t .b { font-weight: 800; font-size: 26rpx; }
.li-t .s { font-size: 18rpx; color: var(--muted); font-weight: 800; letter-spacing: 2rpx; }
.sec-t { display: block; font-size: 28rpx; font-weight: 900; margin: 30rpx 0 18rpx; }
.lineup { display: flex; flex-wrap: wrap; gap: 18rpx; }
.art { padding: 16rpx 28rpx; display: flex; flex-direction: column; align-items: center; transform: rotate(-1.5deg); }
.art:nth-child(2n) { transform: rotate(1.5deg); }
.a-en { font-weight: 900; font-size: 28rpx; }
.a-zh { font-size: 20rpx; color: var(--violet); font-weight: 800; }
.avatars { display: flex; gap: 14rpx; align-items: center; }
.av { width: 72rpx; height: 72rpx; border: 3rpx solid var(--ink); border-radius: 50%; background: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.more { font-size: 22rpx; font-weight: 900; color: var(--violet); }
.join-cta { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 30rpx; margin-top: 26rpx; background: var(--sun); }
.join-cta:active { transform: translate(4rpx,4rpx); box-shadow: 4rpx 4rpx 0 var(--ink); }
.j-l { display: flex; flex-direction: column; }
.j-b { font-weight: 900; font-size: 28rpx; }
.j-s { font-size: 20rpx; font-weight: 700; opacity: .8; }
.j-go { font-weight: 900; font-size: 28rpx; }
.tickets { display: flex; flex-direction: column; gap: 18rpx; }
.tix-opt { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 26rpx; }
.tix-opt.sel { background: var(--lime); }
.to-l { display: flex; flex-direction: column; }
.to-b { font-weight: 900; font-size: 28rpx; }
.to-s { font-size: 20rpx; color: var(--muted); font-weight: 700; }
.to-p { display: flex; flex-direction: column; align-items: flex-end; }
.was { font-size: 20rpx; color: var(--muted); text-decoration: line-through; }
.now { font-weight: 900; font-size: 34rpx; }
.bottom { position: sticky; bottom: 20rpx; margin-top: 40rpx; display: flex; justify-content: space-between; align-items: center; background: var(--paper); border: 4rpx solid var(--ink); border-radius: 99rpx; box-shadow: 8rpx 8rpx 0 var(--ink); padding: 18rpx 18rpx 18rpx 36rpx; }
.bp { font-size: 40rpx; font-weight: 900; }
.per { font-size: 20rpx; color: var(--muted); }
.buy { margin: 0; background: var(--coral); color: #fff; border: 4rpx solid var(--ink); border-radius: 99rpx; font-weight: 900; font-size: 30rpx; padding: 16rpx 44rpx; box-shadow: 4rpx 4rpx 0 var(--ink); line-height: 1.2; }
.buy.ok { background: var(--lime); color: var(--ink); }
.buy:active { transform: translate(3rpx,3rpx); box-shadow: 1rpx 1rpx 0 var(--ink); }
