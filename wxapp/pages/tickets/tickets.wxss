.page { padding: 100rpx 32rpx 220rpx; }
.brand { font-size: 40rpx; font-weight: 900; }
.head { margin-bottom: 24rpx; }
.rows { display: flex; flex-direction: column; gap: 24rpx; }
.stub { display: flex; }
.stub.used { opacity: .55; }
.s-l { flex: 1; display: flex; gap: 18rpx; padding: 24rpx; min-width: 0; }
.s-grad { width: 100rpx; height: 100rpx; border: 4rpx solid var(--ink); border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 50rpx; flex-shrink: 0; }
.s-info { display: flex; flex-direction: column; min-width: 0; }
.s-title { font-weight: 900; font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.s-meta { font-size: 20rpx; color: var(--muted); font-weight: 700; margin-top: 6rpx; }
.s-venue { font-size: 20rpx; color: var(--muted); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.s-status { font-size: 20rpx; font-weight: 900; color: var(--violet); margin-top: 8rpx; }
.s-r { width: 200rpx; border-left: 4rpx dashed var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; padding: 24rpx 12rpx; position: relative; background: var(--cream); border-radius: 0 28rpx 28rpx 0; }
.s-no { font-size: 16rpx; font-weight: 900; letter-spacing: 1rpx; color: var(--muted); }
.qr { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.qr-box { width: 110rpx; height: 110rpx; border: 4rpx solid var(--ink); border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; letter-spacing: -4rpx; background: var(--paper); }
.qr-tap { font-size: 16rpx; font-weight: 900; color: var(--coral); }
.punch { position: absolute; left: -22rpx; top: 50%; margin-top: -22rpx; width: 44rpx; height: 44rpx; background: var(--cream); border: 4rpx solid var(--ink); border-radius: 50%; }
.empty { text-align: center; color: var(--muted); font-weight: 800; padding: 80rpx 0; }
